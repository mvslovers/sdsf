)ATTR DEFAULT(@}_)
 @ TYPE(TEXT)   INTENS(HIGH) COLOR(WHITE)
 } TYPE(TEXT)   INTENS(LOW)  COLOR(GREEN)
 { TYPE(TEXT)   INTENS(LOW)  COLOR(TURQ)
 _ TYPE(INPUT)  INTENS(HIGH) COLOR(RED)    CAPS(ON) JUST(LEFT)
 ! TYPE(OUTPUT) INTENS(HIGH) COLOR(YELLOW) CAPS(OFF) JUST(LEFT)
)BODY
@HELP: Status Panel                             !ISFHMSG                      }
@COMMAND INPUT ===>_ISFHCMD                                                  }
}
}  The Status panel (ST) lists the jobs, started tasks and TSO users on the
}  JES2 queues. You see your own jobs, and the jobs of others as far as
}  RAKF lets you read them (topic 13 of the contents).
}
}  The order: first the jobs waiting to execute, by class; then those
}  executing, batch jobs before TSO users before started tasks; then the
}  output on the print queue. Within each, the higher priority first, then
}  the lower job number. Executing jobs are white, the others blue.
}
}  Type the number of a topic, or press Enter to see them in order.
}
@     1 }The ST command: limiting the list by class and job name
@     2 }Action characters: data sets, output, cancel, purge, hold, ...
@     3 }The fields of the panel
@     4 }Further fields: the ? command
@     5 }Overtyping PRTY and DEST
@     6 }Commands on the Status panel
}
}
}  Enter: topic 1   PF7: contents   PF10: back   PF3: back to SDSF
)PROC
  &ISFHPFK = .PFKEY
  &ZSEL = TRANS(&ISFHCMD
                1,ISFHSTC
                2,ISFHSTA
                3,ISFHSTF
                4,ISFHSTF2
                5,ISFHSTO
                6,ISFHSTM
                *,'?')
  &ZCONT = ISFHSTC
  &ZUP = ISFHTOC
)END
