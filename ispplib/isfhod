)ATTR DEFAULT(@}_)
 @ TYPE(TEXT)   INTENS(HIGH) COLOR(WHITE)
 } TYPE(TEXT)   INTENS(LOW)  COLOR(GREEN)
 { TYPE(TEXT)   INTENS(LOW)  COLOR(TURQ)
 _ TYPE(INPUT)  INTENS(HIGH) COLOR(RED)    CAPS(ON) JUST(LEFT)
 ! TYPE(OUTPUT) INTENS(HIGH) COLOR(YELLOW) CAPS(OFF) JUST(LEFT)
)BODY
@HELP: Output Data Set Panel                    !ISFHMSG                      }
@COMMAND INPUT ===>_ISFHCMD                                                   }
}  The Output Data Set panel shows output: S on a job shows all its data
}  sets one after the other, S on the Job Data Set panel that data set.
}  Each record is one line; carriage control does not add lines.
}
}  The title line shows the job, the data set at the top (DSID), the line
}  at the top within that data set and the columns shown. Column 1 holds
}  the carriage control, so the data begins in column 2.
}
}  END goes back to the panel before. ST goes to a new Status panel.
}  If the output is bigger than the storage SDSF has, the panel shows
}  what fits and says NOT ENOUGH STORAGE.
}
}  Type the number of a topic, or press Enter to see them in order.
}
@     1 }FIND: looking for a string
@     2 }NEXT, PREV, LOCATE and moving around
@     3 }PRINT: output to SYSOUT or a data set
}
}
}
}
}  Enter: topic 1   PF7: contents   PF10: back   PF3: back to SDSF
)PROC
  &ISFHPFK = .PFKEY
  &ZSEL = TRANS(&ISFHCMD
                 1,ISFKFIND
                 2,ISFHODM
                 3,ISFKPRT
                *,'?')
  &ZCONT = ISFKFIND
  &ZUP = ISFHTOC
)END
