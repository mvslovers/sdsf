)ATTR DEFAULT(@}_)
 @ TYPE(TEXT)   INTENS(HIGH) COLOR(WHITE)
 } TYPE(TEXT)   INTENS(LOW)  COLOR(GREEN)
 { TYPE(TEXT)   INTENS(LOW)  COLOR(TURQ)
 _ TYPE(INPUT)  INTENS(HIGH) COLOR(RED)    CAPS(ON) JUST(LEFT)
 ! TYPE(OUTPUT) INTENS(HIGH) COLOR(YELLOW) CAPS(OFF) JUST(LEFT)
)BODY
@HELP: Commands -- ACTION                       !ISFHMSG                      }
@COMMAND INPUT ===>_ISFHCMD                                                   }
}
@  ACTION}[code ...]     up to four
}
}  Chooses which of the replies the system waits for are shown at the end
}  of the log, by the routing codes of their messages:
}
{  1 to 16   }the replies routed to that code
{  MVS       }codes 1 to 12        {  USER  }codes 13 to 16
{  ALL       }all replies          {  OFF   }none
{  ?         }puts the current setting on the command line
}
}  The codes named are added to those set before. ACTION OFF stands
}  alone. The panel says what is now set: ACTION=ALL, ACTION=1,2,3 or
}  ACTION=OFF. The setting is kept for the next session.
}
}  A reply whose message has no routing code is shown unless ACTION is
}  OFF. Each reply shows its routing codes, the time, the job and the
}  message. Up to 30 are shown, the newest first.
}
}
}
}  Enter: next topic   PF7: commands   PF3: back to SDSF
)PROC
  &ISFHPFK = .PFKEY
  &ZCONT = ISFKSYS
  &ZUP = ISFKALL
)END
