)ATTR DEFAULT(@}_)
 @ TYPE(TEXT)   INTENS(HIGH) COLOR(WHITE)
 } TYPE(TEXT)   INTENS(LOW)  COLOR(GREEN)
 { TYPE(TEXT)   INTENS(LOW)  COLOR(TURQ)
 _ TYPE(INPUT)  INTENS(HIGH) COLOR(RED)    CAPS(ON) JUST(LEFT)
 ! TYPE(OUTPUT) INTENS(HIGH) COLOR(YELLOW) CAPS(OFF) JUST(LEFT)
)BODY
@HELP: DA Panel -- the DA Command               !ISFHMSG                      }
@COMMAND INPUT ===>_ISFHCMD                                                   }
}
@  DA}[word ...]     up to four words of these:
}
{  JOB TSU STC INIT }the types: batch jobs, TSO users, started tasks and
}                    idle initiators. DA alone shows the first three.
{  IN OUT           }the positions: in storage or swapped out. DA alone
}                    shows both. TRANS and READY are taken, but SDSF sees
}                    every address space as either IN or OUT.
{  word             }adds that type, or shows that position only
{  Oword            }that type or position only (one such word)
{  NOword           }all but that type or position
{  ALL ALLT ALLP    }all types and positions, all types, all positions;
}                    each stands alone
}
}  Examples:
{    DA INIT        }also the idle initiators
{    DA OJOB        }batch jobs only
{    DA NOTSU OUT   }the swapped-out address spaces, but no TSO users
}
}  An initiator running a job shows as that job, not as INIT.
}
}  Enter: next topic   PF7: DA panel help   PF3: back to SDSF
)PROC
  &ISFHPFK = .PFKEY
  &ZCONT = ISFHDAA
  &ZUP = ISFHDA
)END
