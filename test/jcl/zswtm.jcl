//ZSWTM    JOB (SDSF),'WTOR ROUTCODES',CLASS=A,MSGCLASS=H,TIME=1440
//ASM      EXEC PGM=IFOX00,PARM='NODECK,LOAD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&OBJ,DISP=(,PASS),UNIT=SYSDA,SPACE=(TRK,(1,1))
//SYSIN    DD *
WTORTST  CSECT
         STM   14,12,12(13)
         BALR  12,0
         USING *,12
         XC    E01,E01
         XC    E02,E02
         XC    E11,E11
         XC    E13,E13
         XC    E16,E16
         WTOR  'ZSWTM ROUTCDE 01',R01,4,E01,ROUTCDE=(1)
         WTOR  'ZSWTM ROUTCDE 02',R02,4,E02,ROUTCDE=(2)
         WTOR  'ZSWTM ROUTCDE 11',R11,4,E11,ROUTCDE=(11)
         WTOR  'ZSWTM ROUTCDE 13',R13,4,E13,ROUTCDE=(13)
         WTOR  'ZSWTM ROUTCDE 16',R16,4,E16,ROUTCDE=(16)
         WAIT  5,ECBLIST=LIST
         LM    14,12,12(13)
         SR    15,15
         BR    14
E01      DC    F'0'
E02      DC    F'0'
E11      DC    F'0'
E13      DC    F'0'
E16      DC    F'0'
LIST     DS    0F
         DC    A(E01)
         DC    A(E02)
         DC    A(E11)
         DC    A(E13)
         DC    X'80',AL3(E16)
R01      DS    CL4
R02      DS    CL4
R11      DS    CL4
R13      DS    CL4
R16      DS    CL4
         END
/*
//LKED     EXEC PGM=IEWL,PARM='LIST,MAP',COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSLMOD  DD DSN=&&LOAD(WTORTST),DISP=(,PASS),UNIT=SYSDA,
//            SPACE=(TRK,(1,1,1))
//SYSLIN   DD DSN=&&OBJ,DISP=(OLD,DELETE)
//GO       EXEC PGM=*.LKED.SYSLMOD,COND=(0,NE)
