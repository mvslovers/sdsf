//ZSASM    JOB (SDSF),'ASM SPACING',CLASS=A,MSGCLASS=H
//ASM      EXEC PGM=IFOX00,PARM='NODECK,NOLOAD'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=*
//SYSPUNCH DD DUMMY
//SYSGO    DD DUMMY
//SYSIN    DD *
         TITLE 'SDSF SPACING TEST'
TEST     CSECT
         BALR  12,0
         USING *,12
         SPACE 1
         SR    15,15
         SPACE 2
         BR    14
         SPACE 3
DATA1    DC    CL8'ABC'
         EJECT
DATA2    DC    CL8'DEF'
         TITLE 'SECOND TITLE'
DATA3    DC    CL8'GHI'
         END
/*
